# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cos_agent?schema=public"
# Same as DATABASE_URL locally. On Supabase: DATABASE_URL = pooled (6543,?pgbouncer=true), DIRECT_URL = direct (5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cos_agent?schema=public"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Google OAuth (login + Gmail/Calendar/Drive connectors) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Token encryption (AES-256-GCM envelope key, 32 bytes base64) ---
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# --- LLM ---
LLM_PROVIDER="groq"            # groq | gemini | claude | openai
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""             # aistudio.google.com/apikey  (or GOOGLE_GENERATIVE_AI_API_KEY)
GROQ_API_KEY=""               # console.groq.com/keys
LLM_STRONG_MODEL="claude-sonnet-5"
LLM_CHEAP_MODEL="claude-haiku-4-5-20251001"
OPENAI_STRONG_MODEL="gpt-4o"
OPENAI_CHEAP_MODEL="gpt-4o-mini"
GEMINI_STRONG_MODEL="gemini-3.6-flash"
GEMINI_CHEAP_MODEL="gemini-3.5-flash-lite"
GROQ_STRONG_MODEL="openai/gpt-oss-120b"
GROQ_CHEAP_MODEL="openai/gpt-oss-20b"

# --- Jobs ---
REDIS_URL="redis://localhost:6379"
BRIEFING_HOUR="8"
BRIEFING_MINUTE="30"

# --- Agent run guardrails ---
AGENT_MAX_STEPS="20"
AGENT_MAX_TOOL_CALLS="40"
AGENT_MAX_WALLCLOCK_MS="90000"
AGENT_MAX_COST_USD="1.00"

# --- Phase 2 integrations (optional) ---
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# --- WhatsApp digest (Baileys — worker only, needs one-time `npm run wa:pair`) ---
WHATSAPP_ENABLED="false"        # set "true" to actually send
# Linked-device credentials live in Postgres (WhatsAppAuthCreds/WhatsAppAuthKey) —
# no separate storage config needed.
