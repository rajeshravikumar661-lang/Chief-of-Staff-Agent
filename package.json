{
  "name": "chief-of-staff-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "worker": "tsx src/jobs/worker.ts",
    "db:start": "scripts/dev-db.sh start",
    "db:stop": "scripts/dev-db.sh stop",
    "db:create": "scripts/dev-db.sh create",
    "db:reset": "scripts/dev-db.sh reset && prisma migrate reset --force",
    "setup": "scripts/dev-db.sh start && scripts/dev-db.sh create && prisma migrate dev && prisma generate && tsx prisma/seed.ts",
    "quickstart": "bash scripts/quickstart.sh",
    "wa:pair": "tsx scripts/whatsapp-pair.mts",
    "wa:digest": "tsx scripts/whatsapp-digest.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@auth/prisma-adapter": "^2.7.4",
    "@notionhq/client": "^2.2.15",
    "@prisma/client": "^6.1.0",
    "@slack/web-api": "^7.8.0",
    "@upstash/redis": "^1.38.3",
    "@whiskeysockets/baileys": "^6.7.24",
    "bullmq": "^5.34.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.2",
    "next": "^15.1.3",
    "next-auth": "5.0.0-beta.25",
    "octokit": "^4.0.2",
    "openai": "^4.77.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.2.5",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
